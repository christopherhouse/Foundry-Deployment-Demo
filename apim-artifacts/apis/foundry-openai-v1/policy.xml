<policies>
	<inbound>
		<validate-azure-ad-token tenant-id="{{entra-tenant-id}}" failed-validation-httpcode="401" failed-validation-error-message="A valid Microsoft Entra access token is required.">
			<client-application-ids>
				<application-id>{{agent-client-application-id}}</application-id>
			</client-application-ids>
			<audiences>
				<audience>{{agent-token-audience}}</audience>
			</audiences>
		</validate-azure-ad-token>
		<llm-content-safety backend-id="content-safety-backend" shield-prompt="true" enforce-on-completions="true">
			<categories output-type="EightSeverityLevels">
				<category name="Hate" threshold="4" />
				<category name="SelfHarm" threshold="4" />
				<category name="Sexual" threshold="4" />
				<category name="Violence" threshold="4" />
			</categories>
		</llm-content-safety>
		<base />
		<llm-emit-token-metric namespace="foundry-demo">
			<dimension name="API ID" />
			<dimension name="Operation ID" />
			<dimension name="Product ID" />
			<dimension name="Subscription ID" />
		</llm-emit-token-metric>
		<rate-limit-by-key calls="{{foundry-rate-limit-calls}}" renewal-period="60" counter-key="@(context.Subscription?.Key ?? context.Request.IpAddress)" />
		<set-backend-service backend-id="foundry-backend" />
		<authentication-managed-identity resource="{{foundry-api-audience}}" ignore-error="false" />
		<set-header name="api-key" exists-action="delete" />
	</inbound>
	<backend>
		<base />
	</backend>
	<outbound>
		<base />
	</outbound>
	<on-error>
		<base />
	</on-error>
</policies>