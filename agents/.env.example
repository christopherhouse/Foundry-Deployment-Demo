FOUNDRY_APIM_BASE_URL=https://<apim-service-name>.azure-api.net/openai/v1
FOUNDRY_AGENT_SCOPE=api://<agent-application-id>/.default
FOUNDRY_MODEL=gpt-5-6-luna
FOUNDRY_BRONZE_SUBSCRIPTION_KEY=<created-by-Initialize-AgentDemo.ps1>
FOUNDRY_GOLD_SUBSCRIPTION_KEY=<created-by-Initialize-AgentDemo.ps1>
FOUNDRY_RETRY_MAX_ATTEMPTS=5
FOUNDRY_RETRY_MAX_DELAY_SECONDS=90
FOUNDRY_RETRY_TOTAL_BUDGET_SECONDS=180
